# ==============================================================================
# RetailSync Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=retailsync_user
POSTGRES_PASSWORD=retailsync_secure_pass
POSTGRES_DB=retailsync_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://retailsync_user:retailsync_secure_pass@localhost:5432/retailsync_dw

# Fallback Database (used if local PostgreSQL is unreachable during testing/dev)
SQLITE_DB_PATH=data/retailsync.db

# LLM Configuration (Gemini default, with fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_BATCH_SIZE=20
LLM_TIMEOUT_SECONDS=15

# Monitoring & Alerting
ALERT_CHANNEL=none  # options: telegram, email, none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=

# Pipeline Configuration
LOG_LEVEL=INFO
API_BASE_URL=https://dummyjson.com/products
DATA_RAW_DIR=data/raw
